<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 12+ system splash: crest on the canvas, no icon plate. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowSplashScreenBackground">@color/knightly_canvas</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="android:windowSplashScreenIconBackgroundColor">@color/knightly_canvas</item>
    </style>
    <style name="NormalTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@color/knightly_canvas</item>
    </style>
</resources>
