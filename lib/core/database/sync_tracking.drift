WHEN NOT EXISTS (SELECT 1 FROM sync_meta WHERE "key" = 'applying') AND (SELECT uuid FROM events WHERE id = OLD.event_id) || '_' || OLD.date IS NOT NULL
BEGIN
  DELETE FROM sync_outbox WHERE entity = 'event_exceptions' AND row_key = OLD.event_id || '|' || OLD.date;
  INSERT INTO sync_tombstones (entity, doc_id, deleted_at) VALUES ('event_exceptions', (SELECT uuid FROM events WHERE id = OLD.event_id) || '_' || OLD.date, strftime('%Y-%m-%dT%H:%M:%fZ', 'now')) ON CONFLICT (entity, doc_id) DO UPDATE SET deleted_at = excluded.deleted_at;
END;

CREATE TRIGGER sync_app_settings_insert AFTER INSERT ON app_settings
WHEN NOT EXISTS (SELECT 1 FROM sync_meta WHERE "key" = 'applying') AND NEW."key" NOT LIKE 'backup.%' AND NEW."key" NOT LIKE 'places.%' AND NEW."key" NOT LIKE 'sync.%' AND NEW."key" NOT IN ('home.fab_position', 'appearance.dock_launches', 'homecare.arrival', 'onboarding.welcome_seen')
BEGIN
  INSERT INTO sync_outbox (entity, row_key, changed_at) VALUES ('app_settings', NEW."key", strftime('%Y-%m-%dT%H:%M:%fZ', 'now')) ON CONFLICT (entity, row_key) DO UPDATE SET changed_at = excluded.changed_at;
END;

CREATE TRIGGER sync_app_settings_update AFTER UPDATE ON app_settings
WHEN NOT EXISTS (SELECT 1 FROM sync_meta WHERE "key" = 'applying') AND NEW."key" NOT LIKE 'backup.%' AND NEW."key" NOT LIKE 'places.%' AND NEW."key" NOT LIKE 'sync.%' AND NEW."key" NOT IN ('home.fab_position', 'appearance.dock_launches', 'homecare.arrival', 'onboarding.welcome_seen')
BEGIN
  INSERT INTO sync_outbox (entity, row_key, changed_at) VALUES ('app_settings', NEW."key", strftime('%Y-%m-%dT%H:%M:%fZ', 'now')) ON CONFLICT (entity, row_key) DO UPDATE SET changed_at = excluded.changed_at;
END;

CREATE TRIGGER sync_app_settings_delete AFTER DELETE ON app_settings
WHEN NOT EXISTS (SELECT 1 FROM sync_meta WHERE "key" = 'applying') AND OLD."key" IS NOT NULL AND OLD."key" NOT LIKE 'backup.%' AND OLD."key" NOT LIKE 'places.%' AND OLD."key" NOT LIKE 'sync.%' AND OLD."key" NOT IN ('home.fab_position', 'appearance.dock_launches', 'homecare.arrival', 'onboarding.welcome_seen')
BEGIN
  DELETE FROM sync_outbox WHERE entity = 'app_settings' AND row_key = OLD."key";
  INSERT INTO sync_tombstones (entity, doc_id, deleted_at) VALUES ('app_settings', OLD."key", strftime('%Y-%m-%dT%H:%M:%fZ', 'now')) ON CONFLICT (entity, doc_id) DO UPDATE SET deleted_at = excluded.deleted_at;
END;
