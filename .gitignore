**/local.properties
.env
.env.*

# Generated Drift code (*.g.dart) and drift_schemas/ ARE committed on purpose:
# the project then builds without running build_runner first.

# Original third-party wallpapers and icons from the user's asset zip. Several
# show franchise logos, so they stay local; the app uses the cleaned copies in
# assets/backdrops/ (made by tool/backdrops/prepare_backdrops.py).
/KNIGHTLY_THEME_PACK/user_supplied/

# Reference art from the user (contains franchise insignia): local only, never pushed.
insight/
/Dual-Themed Futuristic Command Center-2.png
