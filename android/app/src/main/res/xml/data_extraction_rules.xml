<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 12+ backup rules for Knightly (see docs/PRIVACY.md).
  Cloud backup: nothing. Knightly promises "no cloud", so the database and
  files are never copied to the user's Google account.
  Device-to-device transfer (a local cable or Wi-Fi copy while setting up a
  new phone) is not listed here and stays allowed: it never leaves the user's
  own devices.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
</data-extraction-rules>
